# ──────────────────────────────────────────────────
# Newsa — Environment Variables
# Copy this file to .env and fill in the values.
# In production (e.g. Render), set these in the dashboard.
# ──────────────────────────────────────────────────

# Dev server port (Render sets PORT automatically)
PORT=5001

# ── Airtable ──────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_CAPITAL_TABLE_ID=

# ── Firebase (client-side, safe to expose) ────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin (server-only) ─────────────────
# Paste the full JSON content of your service account key here.
# Locally you can also set this to a file path.
FIREBASE_SERVICE_ACCOUNT=

# ── OpenRouter (server-only) ─────────────────────
OPENROUTER_API_KEY=

# ── Supabase (server-only) ───────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── SMTP (server-only) ───────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@newsa.io
SMTP_PASS=
SMTP_FROM=Newsa <admin@newsa.io>

# ── App ───────────────────────────────────────────
# Base URL for password-reset and invitation email links.
# In production, set this to your Render URL (e.g. https://newsa-api.onrender.com)
APP_BASE_URL=http://localhost:5001
