# ──────────────────────────────────────────────────
# Newsa — Environment Variables
# Copy to .env and fill in values.
# Local staging (live DB): copy .env.staging.example → .env.staging
# Production (VPS): see DEPLOY.md
# ──────────────────────────────────────────────────

PORT=5001

# ── Airtable [required for news / capital content] ─
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_CAPITAL_TABLE_ID=

# ── Firebase [required for login / admin] ─────────
# Client-side (safe to expose; baked into Vite build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only: paste service account JSON or path to key file
FIREBASE_SERVICE_ACCOUNT=

# ── Supabase [required for latest code to start] ──
# Replaces legacy newsa.db (SQLite). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional APIs ─────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── SMTP [optional; emails] ───────────────────────
SMTP_DISABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@newsa.io
SMTP_PASS=
SMTP_FROM=Newsa <admin@newsa.io>

# ── App URL (password-reset / invitation links) ───
APP_BASE_URL=http://localhost:5001
