# ──────────────────────────────────────────────────
# Newsa — Environment Variables
# Copy this file to .env and fill in the values.
# In production (e.g. Render), set these in the dashboard.
# ──────────────────────────────────────────────────

# Dev server port (Render sets PORT automatically)
PORT=5001

# Local UI: open http://localhost:5001 when using `npm run dev` (Express + Vite together).
# If you use `npm run dev:vite` on port 5173 only, run `npm run dev` in another terminal so /api is proxied to PORT.
# Production (Firebase Hosting) rewrites /api to your function — leave VITE_API_BASE_URL empty for same-origin /api.
# VITE_API_BASE_URL=

# Comma-separated bootstrap admins (matched to Firebase sign-in email). Default includes support@1uptick.com if unset.
# INITIAL_ADMIN_EMAIL=support@1uptick.com

# ── Airtable ──────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_CAPITAL_TABLE_ID=
# Proposed topics field for company filter (must match Airtable column header, e.g. company)
# AIRTABLE_PROPOSED_TOPICS_COMPANY_FIELD=company
# Proposed topics table id for /api/capitalkeywords (default tblH4b2m3tjRRvouI)
# AIRTABLE_CAPITAL_KEYWORDS_TABLE_ID=
# Sort column for that table (default Create date) — must match Airtable exactly
# AIRTABLE_PROPOSED_TOPICS_SORT_FIELD=Create date
# ATFX dashboard stats: proposed topics table (default tblH4b2m3tjRRvouI) and Status column (default Status)
# AIRTABLE_ATFX_STATS_PROPOSED_TABLE_ID=tblH4b2m3tjRRvouI
# AIRTABLE_ATFX_STATS_PROPOSED_STATUS_FIELD=Status
# ATFX articles (Airtable table id, same field layout as Capital articles)
AIRTABLE_ATFX_TABLE_ID=
# Optional override; default is tblFjxMEFtJvsyLZh (1uptick Articles)
AIRTABLE_ONEUPTICK_ARTICLES_TABLE_ID=
# Navbar “Publish status” on Articles: default Status column; optional separate publish column:
# AIRTABLE_ONEUPTICK_ARTICLES_STATUS_FIELD=Status
# AIRTABLE_ONEUPTICK_ARTICLES_PUBLISH_STATUS_FIELD=
# Optional; default tblbZ9qSOcnlxewSA (1uptick SEO — Post=Ready, site non-empty)
# AIRTABLE_ONEUPTICK_SEO_TABLE_ID=
# Optional list-filter field names / option (must match Airtable exactly)
# AIRTABLE_ONEUPTICK_SEO_POST_FIELD=Post
# AIRTABLE_ONEUPTICK_SEO_SITE_FIELD=site
# AIRTABLE_ONEUPTICK_SEO_POST_READY_VALUE=Ready
# SEO left column reads English fields only (defaults Title_EN, Excerpt_EN)
# AIRTABLE_ONEUPTICK_SEO_LIST_TITLE_FIELD=Title_EN
# AIRTABLE_ONEUPTICK_SEO_LIST_EXCERPT_FIELD=Excerpt_EN
# Thumbnail modal → Airtable column (default image_url)
# AIRTABLE_ONEUPTICK_SEO_IMAGE_URL_FIELD=image_url
# Admin-only TradingView (/1uptick/trading-view): optional overrides (defaults table tblJFseDd1tvhShLy, view viwoMDpQ0Yw0855bc, fields title_tc, content_tc). API: GET /api/oneuptick/trading-view
# AIRTABLE_ONEUPTICK_TRADING_VIEW_TABLE_ID=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_LIST_VIEW_ID=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_TITLE_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_CONTENT_FIELD=
# If unset, the server tries common names (Title_tc, title_tc, Title_TC for title; Content_tc, content_tc, Content_TC, Article_tc for body).
# Translate button targets (defaults to title_en/content_en, title_jp/content_jp, title_vi/content_vi, title_ms/content_ms, title_th/content_th):
# AIRTABLE_ONEUPTICK_TRADING_VIEW_TITLE_EN_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_CONTENT_EN_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_TITLE_JP_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_CONTENT_JP_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_TITLE_VI_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_CONTENT_VI_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_TITLE_MS_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_CONTENT_MS_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_TITLE_TH_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_CONTENT_TH_FIELD=
# Hashtag columns (English + Japanese), defaults: hashtag_en, hashtag_jp
# AIRTABLE_ONEUPTICK_TRADING_VIEW_HASHTAG_EN_FIELD=
# AIRTABLE_ONEUPTICK_TRADING_VIEW_HASHTAG_JP_FIELD=
# Chart image column (default `chart`). If it is an Airtable Attachment field, the server writes `[{ url }]`;
# if that fails it retries with a plain URL string (text / URL fields). Ensure the Supabase `article-images` bucket is public so Airtable can ingest attachments.
# AIRTABLE_ONEUPTICK_TRADING_VIEW_CHART_FIELD=chart
# Requesty model for the TradingView Translate button (default openai/gpt-4.1-mini):
# REQUESTY_ONEUPTICK_TRADING_VIEW_TRANSLATE_MODEL=openai/gpt-4.1-mini
# ATFX “approve → generated article” output table (default tblL840we8dgnW9vZ).
# Default Airtable columns (case-sensitive): Title_EN, Title_TC, Excerpt_EN, Excerpt_TC, Content_EN, Content_TC.
# Override only if your base uses different names, e.g. Title_en / Title_tc:
# AIRTABLE_ATFX_ARTICLE_TITLE_EN_FIELD=Title_en
# Optional: primary field if not Title_EN — AIRTABLE_ATFX_ARTICLE_NAME_FIELD=Name
# Optional tracking (set only if those columns exist): Source_Topic_ID, Generated_At, Article_Type, Category, Company
# AIRTABLE_ATFX_ARTICLE_SOURCE_TOPIC_ID_FIELD=Source_Topic_ID
# AIRTABLE_ATFX_ARTICLE_GENERATED_AT_FIELD=Generated_At
# AIRTABLE_ATFX_ARTICLE_ARTICLE_TYPE_FIELD=Article_Type
# Category: retail articles → Retail, institutional → institutional (default field name Category)
# AIRTABLE_ATFX_ARTICLE_CATEGORY_FIELD=Category
# Company: article generation sets ATFX on each new row (default field name Company)
# AIRTABLE_ATFX_ARTICLE_COMPANY_FIELD=Company
# AIRTABLE_ATFX_GENERATED_ARTICLE_TABLE_ID=
# Airtable field that stores the thumbnail URL on each generated article row.
# Must match the column name in your generated-articles table (e.g. "image 1" or "Thumbnail_URL").
# If unset, the thumbnail URL won't be saved on the Airtable record.
# AIRTABLE_ATFX_ARTICLE_THUMBNAIL_FIELD=image 1

# ── Firebase (client-side, safe to expose) ────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin (server-only) ─────────────────
# Paste the full JSON content of your service account key here.
# Locally you can also set this to a file path.
FIREBASE_SERVICE_ACCOUNT=
# Optional; defaults to {project_id}.appspot.com from the service account (1uptick article images use Firebase Storage)
FIREBASE_STORAGE_BUCKET=

# 1uptick Firestore (uptick-prod) — ATFX Markets world map + gainers/losers (read-only; warmed by 1uptick functions).
# ONEUPTICK_FIREBASE_SERVICE_ACCOUNT=
# ONEUPTICK_FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\uptick-prod-firebase-adminsdk.json

# ── Requesty AI (OpenAI-compatible router; server-only) ──
# https://docs.requesty.ai/ — use model ids the router lists (e.g. anthropic/claude-sonnet-4-6)
REQUESTY_API_KEY=
# Optional: override chat URL if Requesty changes the gateway (default: https://router.requesty.ai/v1/chat/completions)
# REQUESTY_CHAT_COMPLETIONS_URL=
# Optional: model for ATFX article JSON (default: anthropic/claude-sonnet-4-6)
# REQUESTY_CLAUDE_ARTICLE_MODEL=anthropic/claude-sonnet-4-6
# Institutional flow only: JSON outline planner (default: openai/gpt-4.1-mini + Azure fallbacks)
# REQUESTY_INSTITUTIONAL_OUTLINE_MODEL=openai/gpt-4.1-mini
# SEO topic JSON via Requesty: Capital, manual ATFX keywords, 1uptick, and ATFX fresh-topics fallback if PERPLEXITY_API_KEY is unset (default: perplexity/sonar-pro on router)
# REQUESTY_CAPITAL_TOPIC_MODEL=perplexity/sonar-pro
# Image generation endpoint + model for ATFX article thumbnails (default: Requesty's /v1/images/generations with fal-ai/nano-banana-2)
# REQUESTY_IMAGES_GENERATIONS_URL=https://router.requesty.ai/v1/images/generations
# Thumbnails: Gemini image models use REQUESTY_CHAT_COMPLETIONS_URL; Azure GPT Image uses REQUESTY_IMAGES_GENERATIONS_URL.
# REQUESTY_ATFX_THUMBNAIL_IMAGE_MODEL=vertex/gemini-2.5-flash-image
# (optional) Azure-only: REQUESTY_ATFX_THUMBNAIL_IMAGE_MODEL=azure/openai/gpt-image-1
# ATFX Research Report — 3-step pipeline (plan → research → write)
# Writer / legacy single-agent model (default: REQUESTY_CLAUDE_ARTICLE_MODEL or anthropic/claude-sonnet-4-6)
# REQUESTY_ATFX_RESEARCH_REPORT_MODEL=anthropic/claude-sonnet-4-6
# REQUESTY_ATFX_RESEARCH_WRITER_MODEL=anthropic/claude-sonnet-4-6
# Planner JSON step (default: openai/gpt-4.1-mini + Azure fallbacks)
# REQUESTY_ATFX_RESEARCH_PLAN_MODEL=openai/gpt-4.1-mini
# Short Q&A replies without full pipeline (default: openai/gpt-4o-mini)
# REQUESTY_ATFX_RESEARCH_CHAT_MODEL=openai/gpt-4o-mini
# Research news via Perplexity on Requesty, then Google flash (default: perplexity/sonar-pro)
# REQUESTY_ATFX_RESEARCH_NEWS_MODEL=perplexity/sonar-pro
# REQUESTY_ATFX_RESEARCH_RESEARCH_MODEL=perplexity/sonar-pro
# EN → TC/SC HTML translation after write phase (default: openai/gpt-4o-mini)
# REQUESTY_ATFX_RESEARCH_TRANSLATE_MODEL=openai/gpt-4o-mini
# Falls back to google/gemini-2.5-flash on failure; long reports are translated in sections (180s timeout per chunk).

# ── Perplexity (server-only, direct API) ─────────
# ATFX “Generate fresh topics” uses api.perplexity.ai with model sonar-pro when set; otherwise fresh topics fall back to Requesty (REQUESTY_CAPITAL_TOPIC_MODEL). Also used for ATFX article research.
# PERPLEXITY_API_KEY=
# PERPLEXITY_CHAT_COMPLETIONS_URL=https://api.perplexity.ai/chat/completions

# ── Financial Modeling Prep (server-only) ───────
# Optional: validate headline/summary numbers vs live quotes for ATFX /api/capitalkeywords/generate
# https://site.financialmodelingprep.com/developer/docs/quickstart
FMP_API_KEY=
# Set to false to keep FMP_API_KEY but skip validation
# FMP_QUOTE_VALIDATION=false

# ── Chart-IMG (server-only) ─────────────────────
# Generate TradingView-style OHLC price charts
# https://doc.chart-img.com/
CHART_IMG_API_KEY=

# QuickChart.io — macro bar/line charts in research reports (optional; free tier works without key)
# QUICKCHART_API_KEY=

# ── Supabase (server-only) ───────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram (server-only) ───────────────────────
# Bot token from @BotFather — used to post ATFX Markets quick analysis to channels.
# The bot must be an admin in each target channel. Channel IDs are configured per user in the Markets UI.
# TELEGRAM_BOT_TOKEN=

# ── SMTP (server-only) ───────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@newsa.io
SMTP_PASS=
SMTP_FROM=Newsa <admin@newsa.io>

# ── App ───────────────────────────────────────────
# Base URL for password-reset and invitation email links.
# In production, set this to your Render URL (e.g. https://newsa-api.onrender.com)
APP_BASE_URL=http://localhost:5001

# ── n8n topic approval webhook (server-only) ─────
# POST with header Record_ID = Airtable record id. Set USER/PASS only if the n8n Webhook node uses Basic Auth.
# Use the Production URL from the Webhook node (path .../webhook/<id>). Do NOT use
# .../webhook-test/... unless you are actively testing in the editor — it returns 404 otherwise.
N8N_APPROVE_WEBHOOK_URL=https://automation.1uptick.ai/webhook/169dbfaa-9541-49d5-a9cd-7232bafc563d
N8N_APPROVE_WEBHOOK_USER=
N8N_APPROVE_WEBHOOK_PASSWORD=
# 1uptick Articles → Publish button. Defaults to the article-publish workflow (not topic approval).
N8N_ONEUPTICK_PUBLISH_WEBHOOK_URL=https://automation.1uptick.ai/webhook/f77f4de5-544a-42f6-816e-9f9d1bdf3172
# If that n8n Webhook node uses Basic Auth, set these (preferred). Falls back to N8N_APPROVE_WEBHOOK_* if unset.
N8N_ONEUPTICK_PUBLISH_WEBHOOK_USER=
N8N_ONEUPTICK_PUBLISH_WEBHOOK_PASSWORD=
# 1uptick SEO → Publish button: optional different workflow URL only. Uses N8N_ONEUPTICK_PUBLISH_WEBHOOK_USER/PASSWORD (same as Articles publish).
N8N_ONEUPTICK_SEO_PUBLISH_WEBHOOK_URL=
# 1uptick Twitt “Post”. Default is production /webhook/... (not /webhook-test/, which 404s when the workflow is not in test mode).
N8N_TWITT_POST_WEBHOOK_URL=
N8N_TWITT_POST_WEBHOOK_USER=
N8N_TWITT_POST_WEBHOOK_PASSWORD=
# ATFX Research Report → WordPress REST API (direct). Application Password auth on the server.
ATFX_WORDPRESS_SITE_URL=https://your-site.com
ATFX_WORDPRESS_USERNAME=editor
ATFX_WORDPRESS_APP_PASSWORD=
# Optional: draft | publish | pending | private (default publish)
ATFX_WORDPRESS_POST_STATUS=publish
