# ──────────────────────────────────────────────────
# Newsa — Local Staging (live database)
# Copy to .env.staging and fill in production values.
# Run: npm run dev:staging  →  http://localhost:5001
# ──────────────────────────────────────────────────

NEW_SA_ENV=staging
PORT=5001

# ── Live Supabase (same project as production) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Live Firebase (same project as production) ───
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT=

# ── Live Airtable (same base as production) ──────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_CAPITAL_TABLE_ID=

# ── Optional APIs ────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── Email (recommended: disabled locally) ────────
# Keep SMTP_DISABLED=true so invites/resets do not email real users.
SMTP_DISABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@newsa.io
SMTP_PASS=
SMTP_FROM=Newsa <admin@newsa.io>

# Links in emails point to localhost when testing mail locally.
APP_BASE_URL=http://localhost:5001

# Do not set VITE_API_BASE_URL — the dev server serves API + SPA on one port.
