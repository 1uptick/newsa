# ──────────────────────────────────────────────────
# Newsa — Local Staging (same data as production)
# Copy to .env.staging and fill with VPS production values.
# Run: npm run dev:staging  →  http://localhost:5001
# Audit VPS first: ./scripts/audit-production.sh
# ──────────────────────────────────────────────────

NEW_SA_ENV=staging
PORT=5001

# ── Supabase [REQUIRED — latest code won't start without this] ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Airtable [required for news / capital content] ───────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_CAPITAL_TABLE_ID=

# ── Firebase [required if you use login / admin] ─────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT=

# ── Optional ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── Email — keep disabled to avoid sending to real users ─────────
SMTP_DISABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@newsa.io
SMTP_PASS=
SMTP_FROM=Newsa <admin@newsa.io>

APP_BASE_URL=http://localhost:5001

# Do not set VITE_API_BASE_URL — dev server serves API + SPA on one port.
