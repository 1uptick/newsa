    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "jsonrepair": "^3.14.0",
    "marked": "^17.0.5",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.14",
    "typescript": "~5.8.2"
